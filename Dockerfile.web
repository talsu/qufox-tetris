# Frontend image: webpack production build → nginx:alpine static serving.
# Build args/deps are all in the repo; assets/styles/index.html are static
# sources served as-is alongside the webpack /build output.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/index.html /usr/share/nginx/html/index.html
COPY --from=build /app/build      /usr/share/nginx/html/build
COPY --from=build /app/assets     /usr/share/nginx/html/assets
COPY --from=build /app/styles     /usr/share/nginx/html/styles
EXPOSE 80
