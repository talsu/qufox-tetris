{
  "name": "qufox-tetris",
  "version": "0.1.0",
  "description": "qufox-tetris is a web tetris game made with Phaser 3 framework.",
  "keywords": [
    "qufox",
    "qufox.com",
    "tetris.qufox.com",
    "tetris",
    "game",
    "web",
    "Phaser",
    "Phaser 3"
  ],
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/parser": "^8.58.1",
    "expose-loader": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "start": "webpack serve --mode production",
    "dev-build": "webpack --mode development",
    "build": "webpack --mode production",
    "test": "jest",
    "test:ci": "jest --coverage --ci",
    "test:bot-simulation": "jest --config jest.slow.config.js --runTestsByPath test/unit/logic/botManager.simulation.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:perf": "playwright test test/performance/",
    "test:all": "npm run test:ci && npm run test:e2e",
    "server:build": "tsc -p tsconfig.server.json",
    "server:dev": "nodemon --watch server --watch src/shared --ext js,ts,json --exec \"npm run server:build && node dist/server/index.js\"",
    "server": "npm run server:build && node server/index.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talsu/play.qufox.com.git"
  },
  "author": {
    "name": "talsu",
    "email": "talsu84@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://tetris.qufox.com",
  "bugs": {
    "url": "https://github.com/talsu/qufox-tetris/issues",
    "email": "talsu84@gmail.com"
  }
}
